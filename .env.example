# Copy to .env and fill in. This file is bundled INSIDE the app (anyone with the APK
# can read it), so only put non-secret settings here. Secrets (DB password, JWT
# secret, AWS keys) belong in the backend's .env only.

# Address of your Duet backend (host + port). Both phones must use the same server.
#   Same Wi-Fi:  http://<your computer's Wi-Fi IP>:4747
#   Emulator:    http://10.0.2.2:4747
#   Deployed:    https://your-duet-domain.com
API_BASE_URL=http://10.0.2.2:4747
